  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Tutoral Steps\n\nHello!\nAre you ready to start your training.\nHere are
    some steps on how to create your first drink.\n\n1) Grab a mug first located
    at the coffee machine\n\n2) A recipe will appear and follow the recipe to complete
    a drink\n\n3) Add the espresso to the mug\n\n4) The milk and flavor dispensers
    will have different options for you to chose \n\n5) Press or click your option
    and place the cup under it\n\n6)If you mess up  anytime, you can throw away your
    cup in the trash and a new cup will appear at the coffee machine\n\n7) After
    completing the recipe, you will recieve a certificate of finishing your traning
    here with us!"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
